{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": [
        "resources/js/*"
      ]
    }
  },
  "include": [
    "resources/js/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "public",
    "vendor"
  ]
}